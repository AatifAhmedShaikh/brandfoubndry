# Server port for the API (Vite dev server proxies /api here)
PORT=8787
# SQLite database file. Created and migrated automatically on start.
DATABASE_PATH=./data/brandfoundry.db
# Optional. Without it, AI actions return a "not configured" state and every artifact stays manually editable.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=claude-opus-5-5
# Max AI generations per user per 10 minutes.
AI_RATE_LIMIT=20
# Set to "true" behind HTTPS so session cookies are Secure.
COOKIE_SECURE=false
